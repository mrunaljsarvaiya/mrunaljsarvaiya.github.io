{% comment %}
  Editorial project row: dominant media on the left, compact description on the right.
  Expects `project` in scope; optional `include.index` for the "01" counter.
  Accent rule colour comes from `project.accent`, otherwise cycles the robot palette.
{% endcomment %}
{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% else %}
  {% assign project_href = project.url | relative_url %}
{% endif %}
{% assign accents = '#79ad52,#db7774,#ab7cda,#659cd6,#e7b74b' | split: ',' %}
{% assign accent_slot = include.index | default: 1 | minus: 1 | modulo: 5 %}
{% assign accent = project.accent | default: accents[accent_slot] %}
<article class="ed-project" style="--ed-accent: {{ accent }}">
  {% if project.img %}
    <a class="ed-project-media" href="{{ project_href }}" tabindex="-1" aria-hidden="true">
      {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 768px) 600px, 95vw" alt=project.title %}
    </a>
  {% endif %}
  <div class="ed-project-body">
    <div class="ed-label">
      {%- if include.index -%}
        {%- if include.index < 10 %}0{% endif %}{{ include.index }} /
      {% endif -%}
      {{ project.category }}
      {%- if project.venue %} &middot; {{ project.venue }}{% endif -%}
    </div>
    <h3><a href="{{ project_href }}">{{ project.title }}</a></h3>
    <span class="ed-accent-rule"></span>
    {% if project.description and project.description != '' %}
      <p>{{ project.description }}</p>
    {% endif %}
    <div class="ed-project-links ed-label">
      <a href="{{ project_href }}">{% if project.redirect %}Project site{% else %}Read more{% endif %} &rarr;</a>
      {% if project.github %}
        <a href="{{ project.github }}">Code &rarr;</a>
      {% endif %}
    </div>
  </div>
</article>
