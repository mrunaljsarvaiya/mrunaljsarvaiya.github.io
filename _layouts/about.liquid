---
layout: default
---
<div class="post ed-home">
  <!-- Hero: animated robot journey -->
  {% include robot_journey.liquid %}

  <!-- 01 / About -->
  <section class="ed-section" id="about">
    <div class="ed-section-head ed-label"><span>01 / About</span></div>
    <div class="ed-about">
      {% if page.profile and page.profile.image %}
        <figure class="ed-portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
          <figcaption class="ed-label">
            <span class="ed-portrait-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</span><br>
            {{ page.subtitle }}
          </figcaption>
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </figure>
      {% endif %}
      <div class="ed-prose">{{ content }}</div>
    </div>
  </section>

  <!-- 02 / Selected work -->
  {% assign featured_projects = site.projects | where: 'featured', true | sort: 'importance' %}
  {% if featured_projects.size > 0 %}
    <section class="ed-section" id="work">
      <div class="ed-section-head ed-label">
        <span>02 / Selected work</span>
        <a href="{{ '/projects/' | relative_url }}">All projects &rarr;</a>
      </div>
      {% for project in featured_projects %}
        {% include projects_horizontal.liquid index=forloop.index %}
      {% endfor %}
    </section>
  {% endif %}

  <!-- 03 / Timeline -->
  {% if page.news and site.announcements.enabled %}
    <section class="ed-section" id="timeline">
      <div class="ed-section-head ed-label">
        <span>03 / Timeline</span>
        <a href="{{ '/news/' | relative_url }}">Full timeline &rarr;</a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <!-- Latest posts -->
  {% if site.latest_posts.enabled %}
    <section class="ed-section">
      <div class="ed-section-head ed-label">
        <span>Latest posts</span>
        <a href="{{ '/blog/' | relative_url }}">All posts &rarr;</a>
      </div>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  <!-- Selected papers -->
  {% if page.selected_papers %}
    <section class="ed-section">
      <div class="ed-section-head ed-label">
        <span>Selected publications</span>
        <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- 04 / Contact -->
  {% if page.social %}
    <section class="ed-section" id="contact">
      <div class="ed-section-head ed-label"><span>04 / Contact</span></div>
      <div class="ed-contact social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    </section>
  {% endif %}

  {% if site.newsletter.enabled and site.footer_fixed %}
    {% include scripts/newsletter.liquid center=true %}
  {% endif %}
</div>
